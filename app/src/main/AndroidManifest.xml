<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- 用于在权限中心引导用户把应用加入电池优化白名单（避免后台计时被冻结） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 读取各 App 使用时长（需用户在系统设置的“使用情况访问”中手动授予） -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        读取各 App 的名称与图标。
        Android 11+ 默认只能看到系统包与自身，屏幕时间类功能需要该可见性声明，
        否则第三方 App 会因取不到名称而被过滤掉。
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
        图标资源名带 _v2 后缀是故意的，不要再改回去：
        系统（尤其国产 ROM）按「包名 + 图标资源」缓存 App 图标，换了图形但沿用旧资源名时，
        锁屏、系统日历这类系统应用会一直沿用缓存的旧图标。
        历史：ic_launcher（老钱ToDo）→ ic_launcher_yishi（2.0 更名）→ ic_launcher_yishi_v2。
    -->
    <application
        android:name=".FocusApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_yishi_v2"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round_yishi_v2"
        android:supportsRtl="true"
        android:theme="@style/Theme.Focus">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Focus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.TimerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
